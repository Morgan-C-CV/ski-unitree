<script>
    var aspectRatio = 1.49970708845929 > 0 ? 1.49970708845929 : 1.5;
    var placeholderWidth = document.getElementById("2319742_placeholder").clientWidth;

    if (placeholderWidth == null){
        placeholderWidth = document.getElementById("2319742_5e2ecdaa-1b03-4c01-aa9d-84e082d7063f").clientWidth;
    }

    if ('False' === 'True') {
        document.getElementById("2319742_5e2ecdaa-1b03-4c01-aa9d-84e082d7063f").style.objectFit = "cover";
    }
    else{
        document.getElementById("2319742_5e2ecdaa-1b03-4c01-aa9d-84e082d7063f").style.objectFit = "contain";
    }

    var windowWidth = window.innerWidth;
    var imageLayout;

    if (windowWidth < 768) {
        imageLayout = 'originalimage';
    } else {
        imageLayout = 'originalimage';
    }

    var placeholderHeight;

    switch (imageLayout) {
        case 'panorama':
            placeholderHeight = Math.round(0.35 * placeholderWidth);
            break;
        case 'landscape':
            placeholderHeight = Math.round(0.71 * placeholderWidth);
            break;
        case 'portrait':
            placeholderHeight = Math.round(1.4 * placeholderWidth);
            break;
        case 'square':
            placeholderHeight = placeholderWidth;
            break;
        case 'originalimage':
        default:
            var naturalHeight = 1707;
            var aspectRatioHeight = 1 / aspectRatio * placeholderWidth;
            placeholderHeight = Math.min.apply(null, [naturalHeight, aspectRatioHeight].filter(Number));
            break;
    }

    document.getElementById("2319742_placeholder").style.width = "" + placeholderWidth + "px";
    document.getElementById("2319742_placeholder").style.height = "" + placeholderHeight + "px";

    
    document.getElementById("2319742_5e2ecdaa-1b03-4c01-aa9d-84e082d7063f").style.width = "" + placeholderWidth + "px";
    document.getElementById("2319742_5e2ecdaa-1b03-4c01-aa9d-84e082d7063f").style.height = "" + placeholderHeight + "px";
    

</script>
