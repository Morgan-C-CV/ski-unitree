<script>
    var aspectRatio = 5.20359281437126 > 0 ? 5.20359281437126 : 1.5;
    var placeholderWidth = document.getElementById("2310926_placeholder").clientWidth;

    if (placeholderWidth == null){
        placeholderWidth = document.getElementById("2310926_6819c748-94bf-4240-a3a8-c5aa177f6684").clientWidth;
    }

    if ('False' === 'True') {
        document.getElementById("2310926_6819c748-94bf-4240-a3a8-c5aa177f6684").style.objectFit = "cover";
    }
    else{
        document.getElementById("2310926_6819c748-94bf-4240-a3a8-c5aa177f6684").style.objectFit = "contain";
    }

    var windowWidth = window.innerWidth;
    var imageLayout;

    if (windowWidth < 768) {
        imageLayout = 'originalimage';
    } else {
        imageLayout = 'originalimage';
    }

    var placeholderHeight;

    switch (imageLayout) {
        case 'panorama':
            placeholderHeight = Math.round(0.35 * placeholderWidth);
            break;
        case 'landscape':
            placeholderHeight = Math.round(0.71 * placeholderWidth);
            break;
        case 'portrait':
            placeholderHeight = Math.round(1.4 * placeholderWidth);
            break;
        case 'square':
            placeholderHeight = placeholderWidth;
            break;
        case 'originalimage':
        default:
            var naturalHeight = 334;
            var aspectRatioHeight = 1 / aspectRatio * placeholderWidth;
            placeholderHeight = Math.min.apply(null, [naturalHeight, aspectRatioHeight].filter(Number));
            break;
    }

    document.getElementById("2310926_placeholder").style.width = "" + placeholderWidth + "px";
    document.getElementById("2310926_placeholder").style.height = "" + placeholderHeight + "px";

    
    document.getElementById("2310926_6819c748-94bf-4240-a3a8-c5aa177f6684").style.width = "" + placeholderWidth + "px";
    document.getElementById("2310926_6819c748-94bf-4240-a3a8-c5aa177f6684").style.height = "" + placeholderHeight + "px";
    

</script>
