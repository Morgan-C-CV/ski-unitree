<script>
    var aspectRatio = 1.52224824355972 > 0 ? 1.52224824355972 : 1.5;
    var placeholderWidth = document.getElementById("2319847_placeholder").clientWidth;

    if (placeholderWidth == null){
        placeholderWidth = document.getElementById("2319847_48b2d9d3-5693-42ab-a430-69ed73239267").clientWidth;
    }

    if ('True' === 'True') {
        document.getElementById("2319847_48b2d9d3-5693-42ab-a430-69ed73239267").style.objectFit = "cover";
    }
    else{
        document.getElementById("2319847_48b2d9d3-5693-42ab-a430-69ed73239267").style.objectFit = "contain";
    }

    var windowWidth = window.innerWidth;
    var imageLayout;

    if (windowWidth < 768) {
        imageLayout = 'landscape';
    } else {
        imageLayout = 'landscape';
    }

    var placeholderHeight;

    switch (imageLayout) {
        case 'panorama':
            placeholderHeight = Math.round(0.35 * placeholderWidth);
            break;
        case 'landscape':
            placeholderHeight = Math.round(0.71 * placeholderWidth);
            break;
        case 'portrait':
            placeholderHeight = Math.round(1.4 * placeholderWidth);
            break;
        case 'square':
            placeholderHeight = placeholderWidth;
            break;
        case 'originalimage':
        default:
            var naturalHeight = 427;
            var aspectRatioHeight = 1 / aspectRatio * placeholderWidth;
            placeholderHeight = Math.min.apply(null, [naturalHeight, aspectRatioHeight].filter(Number));
            break;
    }

    document.getElementById("2319847_placeholder").style.width = "" + placeholderWidth + "px";
    document.getElementById("2319847_placeholder").style.height = "" + placeholderHeight + "px";

    
    document.getElementById("2319847_48b2d9d3-5693-42ab-a430-69ed73239267").style.width = "" + placeholderWidth + "px";
    document.getElementById("2319847_48b2d9d3-5693-42ab-a430-69ed73239267").style.height = "" + placeholderHeight + "px";
    

</script>
