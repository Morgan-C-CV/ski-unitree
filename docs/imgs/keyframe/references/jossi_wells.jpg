<script>
    var aspectRatio = 2.99082568807339 > 0 ? 2.99082568807339 : 1.5;
    var placeholderWidth = document.getElementById("2421374_placeholder").clientWidth;

    if (placeholderWidth == null){
        placeholderWidth = document.getElementById("2421374_69b21a26-ce5a-4722-88cb-5e4c3851739a").clientWidth;
    }

    if ('False' === 'True') {
        document.getElementById("2421374_69b21a26-ce5a-4722-88cb-5e4c3851739a").style.objectFit = "cover";
    }
    else{
        document.getElementById("2421374_69b21a26-ce5a-4722-88cb-5e4c3851739a").style.objectFit = "contain";
    }

    var windowWidth = window.innerWidth;
    var imageLayout;

    if (windowWidth < 768) {
        imageLayout = 'originalimage';
    } else {
        imageLayout = 'originalimage';
    }

    var placeholderHeight;

    switch (imageLayout) {
        case 'panorama':
            placeholderHeight = Math.round(0.35 * placeholderWidth);
            break;
        case 'landscape':
            placeholderHeight = Math.round(0.71 * placeholderWidth);
            break;
        case 'portrait':
            placeholderHeight = Math.round(1.4 * placeholderWidth);
            break;
        case 'square':
            placeholderHeight = placeholderWidth;
            break;
        case 'originalimage':
        default:
            var naturalHeight = 218;
            var aspectRatioHeight = 1 / aspectRatio * placeholderWidth;
            placeholderHeight = Math.min.apply(null, [naturalHeight, aspectRatioHeight].filter(Number));
            break;
    }

    document.getElementById("2421374_placeholder").style.width = "" + placeholderWidth + "px";
    document.getElementById("2421374_placeholder").style.height = "" + placeholderHeight + "px";

    
    document.getElementById("2421374_69b21a26-ce5a-4722-88cb-5e4c3851739a").style.width = "" + placeholderWidth + "px";
    document.getElementById("2421374_69b21a26-ce5a-4722-88cb-5e4c3851739a").style.height = "" + placeholderHeight + "px";
    

</script>
